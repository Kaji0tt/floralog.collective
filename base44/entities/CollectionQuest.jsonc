{
  "name": "CollectionQuest",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Titel der Sammlungs-Quest"
    },
    "description": {
      "type": "string",
      "description": "Beschreibung der Quest"
    },
    "reward": {
      "type": "string",
      "description": "Belohnung f\u00fcr die Quest (z.B. 'Titel: Sammler', 'Hintergrund: Collection', etc.)"
    },
    "target_plants": {
      "type": "array",
      "description": "Liste der Zielpflanzen (Plant IDs oder Namen)",
      "items": {
        "type": "string"
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Ist die Quest aktiv?"
    },
    "icon_emoji": {
      "type": "string",
      "description": "Emoji-Icon f\u00fcr die Quest"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "Leicht",
        "Mittel",
        "Schwer",
        "Extrem"
      ],
      "default": "Mittel",
      "description": "Schwierigkeitsgrad"
    }
  },
  "required": [
    "title",
    "description",
    "target_plants"
  ]
}