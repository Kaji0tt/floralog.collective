{
  "name": "UserCollectionQuest",
  "type": "object",
  "properties": {
    "collection_quest_id": {
      "type": "string",
      "description": "ID der Sammlungs-Quest"
    },
    "accepted": {
      "type": "boolean",
      "default": false,
      "description": "Wurde die Quest angenommen?"
    },
    "accepted_date": {
      "type": "string",
      "format": "date-time",
      "description": "Wann wurde die Quest angenommen"
    },
    "discovered_plants": {
      "type": "array",
      "description": "Liste der bereits entdeckten Zielpflanzen (Plant IDs)",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "progress": {
      "type": "integer",
      "default": 0,
      "description": "Anzahl entdeckter Pflanzen"
    },
    "completed": {
      "type": "boolean",
      "default": false,
      "description": "Wurden die Anforderungen erf\u00fcllt?"
    },
    "completed_date": {
      "type": "string",
      "format": "date-time",
      "description": "Wann wurden die Anforderungen erf\u00fcllt"
    },
    "redeemed": {
      "type": "boolean",
      "default": false,
      "description": "Wurde die Quest eingel\u00f6st?"
    },
    "redeemed_date": {
      "type": "string",
      "format": "date-time",
      "description": "Wann wurde die Quest eingel\u00f6st"
    }
  },
  "required": [
    "collection_quest_id"
  ]
}