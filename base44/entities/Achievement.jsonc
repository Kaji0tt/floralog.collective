{
  "name": "Achievement",
  "type": "object",
  "properties": {
    "achievement_number": {
      "type": "integer",
      "description": "Nummer des Erfolgs (1-100)"
    },
    "title": {
      "type": "string",
      "description": "Titel des Erfolgs"
    },
    "description": {
      "type": "string",
      "description": "Beschreibung des Erfolgs"
    },
    "icon_emoji": {
      "type": "string",
      "description": "Emoji f\u00fcr den Erfolg (z.B. \ud83d\udc65, \ud83c\udf1f)"
    },
    "rarity": {
      "type": "string",
      "enum": [
        "Ungew\u00f6hnlich",
        "Selten",
        "Episch",
        "Legend\u00e4r"
      ],
      "description": "Seltenheit des Erfolgs"
    },
    "requirement": {
      "type": "string",
      "description": "Was muss erreicht werden"
    },
    "reward_name": {
      "type": "string",
      "description": "Name der Belohnung aus der Reward-Entit\u00e4t (z.B. 'forest_background')"
    }
  },
  "required": [
    "achievement_number",
    "title",
    "description",
    "icon_emoji",
    "rarity"
  ]
}